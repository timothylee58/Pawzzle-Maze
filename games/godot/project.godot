config_version=5

[application]
config/name="Pawzzle Maze"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.5", "GL Compatibility")

[display]
window/size/viewport_width=1100
window/size/viewport_height=840
window/size/window_width_override=1100
window/size/window_height_override=840
window/stretch/mode="canvas_items"
window/size/min_width=900
window/size/min_height=700

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
environment/defaults/default_clear_color=Color(0.92, 0.94, 0.9, 1)

[input_devices]
pointing/emulate_mouse_from_touch=true
