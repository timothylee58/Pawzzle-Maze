config_version=5

[application]
config/name="Pawzzle Maze"
config/icon="res://Sprites/textures/princess_mocha.png"
boot_splash/show_image=false
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")

[autoload]
GPX="*res://addons/gpx-godot-plugin/gpx.gd"

[display]
window/size/viewport_width=1100
window/size/viewport_height=840
window/size/window_width_override=1100
window/size/window_height_override=840
window/size/min_width=320
window/size/min_height=320
window/stretch/mode="disabled"

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
environment/defaults/default_clear_color=Color(0.92, 0.94, 0.9, 1)

[input_devices]
pointing/emulate_mouse_from_touch=true

[editor_plugins]
enabled=PackedStringArray("res://addons/gpx-godot-plugin/plugin.cfg")
