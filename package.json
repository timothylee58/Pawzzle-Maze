{
  "name": "pawzzle-maze",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web -c green,cyan \"npm run dev -w @pawzzle/api\" \"npm run dev -w @pawzzle/web\"",
    "build": "npm run build -w @pawzzle/web",
    "test": "npm run test --workspaces --if-present",
    "start": "npm run start -w @pawzzle/api",
    "check": "npm test && npm run build",
    "format": "prettier --write \"apps/**/src/**/*.js\" \"apps/web/*.html\" \"apps/web/src/*.css\" \"packages/**/*.js\" \"**/package.json\" README.md",
    "format:check": "prettier --check \"apps/**/src/**/*.js\" \"apps/web/*.html\" \"apps/web/src/*.css\" \"packages/**/*.js\" \"**/package.json\" README.md"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "prettier": "^3.9.10"
  }
}
